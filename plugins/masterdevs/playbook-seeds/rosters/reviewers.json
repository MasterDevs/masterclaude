[
  {
    "name": "correctness",
    "lens": "correctness",
    "agentType": "eng-skills:pr-reviewer",
    "fallbackAgentType": "masterdevs:engineer-as-reviewer-prompt",
    "model": "opus",
    "triggers": { "always": true },
    "lessonsLane": "correctness"
  },
  {
    "name": "security",
    "lens": "security",
    "agentType": "masterdevs:security-reviewer",
    "model": "fable",
    "triggers": {
      "lenses": ["backend", "data", "integration"],
      "globs": ["**/auth*/**", "**/payment*/**", "**/*secret*", "**/crypto/**"],
      "sensitiveTier": true
    },
    "lessonsLane": "security"
  },
  {
    "name": "performance",
    "lens": "performance",
    "agentType": "masterdevs:perf-reviewer",
    "model": "opus",
    "triggers": { "lenses": ["backend", "data", "algo"] },
    "lessonsLane": "perf"
  },
  {
    "name": "frontend-design",
    "lens": "frontend",
    "agentType": "masterdevs:design-reviewer",
    "model": "opus",
    "triggers": { "globs": ["**/*.tsx", "**/*.vue", "**/components/**", "**/*.css"] },
    "lessonsLane": "frontend"
  }
]
